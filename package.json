{
  "name": "cachelab",
  "version": "0.1.0",
  "private": true,
  "description": "In-memory key/value cache backend",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "openapi:lint": "redocly lint --config redocly.yaml openapi.yaml",
    "start": "node dist/main.js",
    "test": "npm run build && node --test \"tests/**/*.test.mjs\"",
    "test:unit": "npm run build && node --test \"tests/unit/**/*.test.mjs\"",
    "test:integration": "npm run build && node --test \"tests/integration/**/*.test.mjs\"",
    "test:scenarios": "npm run build && node --test \"tests/scenarios/**/*.test.mjs\"",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=\"dist/**\" --test-coverage-lines=80 --test-coverage-branches=80 \"tests/**/*.test.mjs\" && node --test --experimental-test-coverage --test-coverage-include=\"dist/engine/**\" --test-coverage-lines=90 --test-coverage-branches=90 \"tests/**/*.test.mjs\"",
    "typecheck:contracts": "tsc -p tsconfig.type-tests.json",
    "test": "npm run build && npm run typecheck:contracts && node --test tests/*.test.mjs",
    "check": "npm run openapi:lint && npm test",
    "launch": "npm ci && bash -c 'set -a; source .env; set +a; npm run check; npm start'"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "@redocly/cli": "^2.77.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/swagger-ui-express": "^4.1.8",
    "autocannon": "^9.0.0",
    "tinybench": "^6.2.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
